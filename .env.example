# PAPeR side-model config — COPY this file to `.env` and fill in your own key.
#   cp .env.example .env    then paste your key below.
# `.env` is gitignored, so your key never gets committed.

# Which provider receives deflected questions (the vendor toggle).
# Supported today: gemini
SIDECAR_VENDOR=gemini

# YOUR OWN API key for that provider. This is the whole off-quota mechanism:
# deflected questions are billed to this key, not your Claude subscription.
# Gemini keys come from https://aistudio.google.com/apikey
SIDECAR_API_KEY=

# Optional: override the model id (defaults per provider, e.g. gemini-2.5-flash).
# SIDECAR_MODEL=gemini-2.5-flash

# Optional: request timeout in seconds (default 15).
# SIDECAR_TIMEOUT=15
